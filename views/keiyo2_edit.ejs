<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= data.name %>の編集</title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>

  <form action="/keiyo2/update/<%= id %>" method="POST">
    <p>
      <label>駅コード：
        <input name="code" value="<%= data.code %>" required>
      </label>
    </p>
    <p>
      <label>駅名：
        <input name="name" value="<%= data.name %>" required>
      </label>
    </p>
    <p>
      <label>乗り換え線：
        <input name="change" value="<%= data.change %>">
      </label>
    </p>
    <p>
      <label>乗降客数：
        <input type="number" name="passengers"
               value="<%= data.passengers %>" required>
      </label>
    </p>
    <p>
      <label>東京駅からの距離：
        <input type="number" step="0.1" name="distance"
               value="<%= data.distance %>" required>
      </label>
    </p>

    <input type="submit" value="更新">
  </form>

  <a href="/keiyo2">一覧に戻る</a>
</body>
</html>